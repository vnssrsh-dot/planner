# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Публичный HTTPS-адрес, по которому Telegram откроет Mini App
# (для локальной разработки — адрес туннеля ngrok / cloudflared, указывающего на WEB_PORT)
WEBAPP_URL=https://example.ngrok-free.app

# Порт локального веб-сервера (Mini App + API)
WEB_PORT=8080

# Часовой пояс по умолчанию (пока пользователь не открыл Mini App)
DEFAULT_TZ=Europe/Kyiv

# Во сколько (по местному времени) присылать вечернее напоминание о невыполненных задачах
EVENING_HOUR=21

# За сколько минут до задачи со временем присылать напоминание
REMIND_BEFORE_MIN=15

# Путь к базе SQLite
DB_PATH=planner.db

# Только для разработки: открыть Mini App в обычном браузере без Telegram
# под этим id пользователя. В проде оставьте пустым!
DEV_USER_ID=
